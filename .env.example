# ========================

# 🔐 SECURITY

# ========================

SECRET_KEY=your-django-secret-key-here

DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

# ========================

# 💾 DATABASE

# ========================

DB_ENGINE=django.db.backends.mysql

DB_NAME=your_database_name

DB_USER=root

DB_PASSWORD=your_database_password

DB_HOST=127.0.0.1

DB_PORT=3306

# ========================

# 🌍 INTERNATIONALIZATION

# ========================

LANGUAGE_CODE=en-us

TIME_ZONE=UTC

# ========================

# 📁 STATIC & MEDIA

# ========================

STATIC_URL=/static/

MEDIA_URL=/media/
